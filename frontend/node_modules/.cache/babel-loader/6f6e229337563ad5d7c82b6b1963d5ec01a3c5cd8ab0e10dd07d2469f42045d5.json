{"ast":null,"code":"import axios from\"axios\";import{LOGIN_USER_ERROR,LOGIN_USER_LOADING,LOGIN_USER_SUCCESS}from\"./user_types\";import{BASE_URL}from\"../../constants/config\";export const getUser=obj=>async dispatch=>{dispatch({type:LOGIN_USER_LOADING});try{let data=await axios(BASE_URL+\"/user/login\",{method:\"post\",data:obj});let{message,user,token,status}=data.data;if(status===1)dispatch({type:LOGIN_USER_SUCCESS,payload:{user,token}});else{alert(message);dispatch({type:LOGIN_USER_ERROR});}}catch(error){dispatch({type:LOGIN_USER_ERROR});}};","map":{"version":3,"names":["axios","LOGIN_USER_ERROR","LOGIN_USER_LOADING","LOGIN_USER_SUCCESS","BASE_URL","getUser","obj","dispatch","type","data","method","message","user","token","status","payload","alert","error"],"sources":["D:/ThunderNote-GenAI/frontend/src/redux/users/user_actions.js"],"sourcesContent":["import axios from \"axios\"\nimport { LOGIN_USER_ERROR, LOGIN_USER_LOADING, LOGIN_USER_SUCCESS } from \"./user_types\"\nimport { BASE_URL } from \"../../constants/config\"\n\nexport const getUser = (obj) => async(dispatch) => {\n    dispatch({type: LOGIN_USER_LOADING})\n    try {\n        let data = await axios(BASE_URL+\"/user/login\", {\n        method: \"post\",\n        data: obj\n        })\n        let {message, user, token, status} = data.data\n        if(status === 1)\n        dispatch({type: LOGIN_USER_SUCCESS, payload: {user, token}})\n        else\n        {\n            alert(message)\n            dispatch({type: LOGIN_USER_ERROR})\n        }\n\n    } catch (error) {\n        dispatch({type: LOGIN_USER_ERROR})\n    }\n}"],"mappings":"AAAA,MAAO,CAAAA,KAAK,KAAM,OAAO,CACzB,OAASC,gBAAgB,CAAEC,kBAAkB,CAAEC,kBAAkB,KAAQ,cAAc,CACvF,OAASC,QAAQ,KAAQ,wBAAwB,CAEjD,MAAO,MAAM,CAAAC,OAAO,CAAIC,GAAG,EAAK,KAAM,CAAAC,QAAQ,EAAK,CAC/CA,QAAQ,CAAC,CAACC,IAAI,CAAEN,kBAAkB,CAAC,CAAC,CACpC,GAAI,CACA,GAAI,CAAAO,IAAI,CAAG,KAAM,CAAAT,KAAK,CAACI,QAAQ,CAAC,aAAa,CAAE,CAC/CM,MAAM,CAAE,MAAM,CACdD,IAAI,CAAEH,GACN,CAAC,CAAC,CACF,GAAI,CAA